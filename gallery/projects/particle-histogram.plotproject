      "xLabel": "Particle diameter",
      "xUnit": "nm",
      "yLabel": "Frequency",
      "yUnit": "%",
      "xScale": "linear",
      "yScale": "linear",
      "legend": false,
      "legendPosition": "best",
      "legendFontScale": 0.88,
      "legendScale": 0.85,
      "hideYTickLabels": false,
      "hideYTicks": false,
      "transparent": false,
      "backgroundColor": "#ffffff",
      "backgroundAlpha": 1,
      "plotBackgroundEnabled": true,
      "plotBackgroundColor": "#ffffff",
      "plotBackgroundAlpha": 1,
      "grid": false,
      "xMin": "60",
      "xMax": "440",
      "xStep": "100",
      "yMin": "0",
      "yMax": "20",
      "yStep": "5"
    },
    "series": [
      {
        "x": 0,
        "y": 1,
        "name": "Diameter",
        "visible": true,
        "color": "#0072B2",
        "scatterColor": "auto",
        "mode": "line",
        "lineWidth": 0.85,
        "lineStyle": "-",
        "lineAlpha": 1,
        "marker": "o",
        "markerSize": 9,
        "markerEdgeColor": "auto",
        "markerFaceColor": "auto",
        "markerEdgeAlpha": 1,
        "markerFaceAlpha": 0.85,
        "xOffset": 0,
        "yOffset": 0,
        "error": "",
        "errorMode": "auto",
        "errorMin": "",
        "errorMax": "",
        "xColumn": "Particle ID",
        "yColumn": "Diameter / nm",
        "errorColumn": "",
        "errorMinColumn": "",
        "errorMaxColumn": ""
      }
    ],
    "options": {
      "diameterColumn": 1
    },
    "annotations": []
  },
  "data": {
    "filename": "particle-histogram.csv",
    "base64": "",
    "sheetIndex": 0,
    "headerRow": 1,
    "sample": false
  },
  "fonts": [],
  "workspace": {
    "saveName": "particle-histogram",
    "pngDpi": 1200,
    "view": {
      "zoom": 1,
