{
  "format": "plotlauncher-project",
  "version": 1,
  "settings": {
    "format": "plotlauncher-web",
    "version": 1,
    "data": {
      "filename": "particle-histogram.csv",
      "sheet": "CSV",
      "headerRow": 1
    },
    "plotType": "Particle Histogram",
    "axes": {
      "width": 6.7,
      "height": 4.8,
      "fontFamily": "Liberation Sans",
      "japaneseFontFamily": "Noto Sans JP",
